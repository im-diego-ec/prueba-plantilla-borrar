# Copiar a .env (que esta en .gitignore) y completar. Ningun valor real de
# produccion vive en un archivo: en AWS los inyecta la definicion de tarea de
# ECS desde Parameter Store, y crear o rotar un parametro es tarea humana.

# Base local que levanta docker-compose de la raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi-proyecto"

# Puerto del API y origen del frontend permitido por CORS.
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Auth. Sin SUPABASE_URL y sin ALLOW_DEV_AUTH=true el API NO arranca: es
# fail-closed a proposito. ALLOW_DEV_AUTH acepta la identidad que manda el
# cliente por el header x-dev-user-id, asi que SOLO va en una maquina de
# desarrollo.
#
# SUPABASE_URL es la URL del proyecto (Project Settings > Data API), y es LO
# UNICO que el API necesita para comprobar tokens: de ella sale el JWKS publico
# con las claves de firma. Aca NO va ninguna clave secreta de Supabase — si
# alguna vez aparece una en este archivo, esta de mas.
#
# El proyecto de desarrollo es OTRO proyecto de Supabase, separado del de
# produccion, igual que la base: un token de dev no debe valer en prod, y con
# emisores distintos no vale ni por accidente.
ALLOW_DEV_AUTH=true
SUPABASE_URL=""

# ALTERNATIVA: CLERK. Si el proyecto prefiere Clerk como proveedor de identidad
# —tiene mas componentes de interfaz listos y organizaciones/roles de fabrica—
# el cambio es acotado y esta del todo dentro de este andamio: se instala
# @clerk/backend en api/ y @clerk/clerk-react en web/, api/src/middleware/auth.ts
# verifica con `verifyToken(token, { jwtKey })` contra CLERK_JWT_KEY en vez de
# con el JWKS, y estas dos variables pasan a ser CLERK_SECRET_KEY y
# CLERK_JWT_KEY. Las TRES invariantes del marco no cambian y hay que conservarlas
# tal cual: la identidad sale de los claims firmados, el bypass no depende de
# NODE_ENV, y un fallo de verificacion es 401 sin detalle en el cuerpo.
#
# Por que el andamio trae Supabase y no Clerk: el proyecto ya usa Supabase para
# la base, asi que su login es UNA cuenta en vez de dos y UN juego de llaves en
# vez de dos. Los dos planes gratuitos dan 50.000 usuarios activos al mes, o sea
# la eleccion no se paga con capacidad. Lo que no conviene es tener las dos.
